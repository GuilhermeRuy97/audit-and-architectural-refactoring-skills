# Copy this file to .env and fill in real values before running in production.
# Never commit .env to version control.

# Required: a long random string used to sign JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-key-here

# Optional: path to the SQLite database file (default: loja.db)
DATABASE_PATH=loja.db

# Optional: set to "true" only in development (default: false)
DEBUG=false
